{
  "name": "greencode-av3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GreenCode AV3 — API REST de logística reversa e integração pública",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run prisma:generate && npm run build:ts",
    "start": "node dist/src/server.js",
    "test": "npm run test:unit",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "npm run prisma:generate && prisma db seed",
    "db:studio": "prisma studio",
    "test:integration": "npm run build && node --test --test-concurrency=1 --test-reporter=spec dist/src/tests/integration/*.integration.test.js",
    "dev:worker": "tsx watch src/worker.ts",
    "worker": "node dist/src/worker.js",
    "start:worker": "node dist/src/worker.js",
    "test:unit": "npm run build && node --test --test-reporter=spec dist/src/tests/*.test.js",
    "test:demonstracao": "npm run build && node dist/src/tests/demonstracao.js",
    "test:av3": "npm run prisma:validate && npm run build && node --test --test-reporter=spec dist/src/tests/*.test.js && node dist/src/tests/demonstracao.js && node --test --test-concurrency=1 --test-reporter=spec dist/src/tests/integration/*.integration.test.js",
    "build:ts": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "db:seed:generated": "prisma db seed",
    "test:unit:dist": "node --test --test-reporter=spec dist/src/tests/*.test.js",
    "test:demonstracao:dist": "node dist/src/tests/demonstracao.js",
    "test:integration:dist": "node --test --test-concurrency=1 --test-reporter=spec dist/src/tests/integration/*.integration.test.js"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.5",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "bullmq": "^5.58.5",
    "simple-statistics": "^7.8.8"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "prisma": "^7.10.1"
  }
}
