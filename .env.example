# Substitua todos os placeholders por valores locais fortes antes de iniciar.
# Nunca versione o arquivo .env real nem reutilize valores de avaliação em produção.
# The setup guide replaces this with a unique name for each local clone.
# This isolates containers and named volumes from other checkouts of the repository.
COMPOSE_PROJECT_NAME=greencode-local
POSTGRES_USER=greencode
# Generate once; keep unchanged while this Compose project/volume is reused.
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=greencode
# URL para comandos Prisma executados no Windows/Ubuntu host. API/worker/test-runner em Compose recebem DATABASE_URL interpolada diretamente pelo docker-compose.yml.
DATABASE_URL=postgresql://greencode:replace-with-a-local-database-password@127.0.0.1:5433/greencode?schema=public

JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

BOOTSTRAP_ADMIN_USERNAME=admin_av3_local
BOOTSTRAP_ADMIN_NAME=Administrador Local AV3
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Agendamento recorrente das análises BullMQ (milissegundos; mínimo 60000).
# Used only by API/worker running on the host; Compose containers use redis:6379 internally.
REDIS_URL=redis://127.0.0.1:6379
ANALYTICS_EFFICIENCY_INTERVAL_MS=3600000
ANALYTICS_PROFITABILITY_INTERVAL_MS=21600000
ANALYTICS_USEFUL_LIFE_INTERVAL_MS=86400000
ANALYTICS_WORKER_CONCURRENCY=2
