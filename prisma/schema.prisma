generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

enum StatusProcessamentoLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

enum StatusRelatorio {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

enum TipoAnalise {
  EFICIENCIA_OPERACIONAL
  RENTABILIDADE_EQUIPAMENTOS
  VIDA_UTIL_REMANESCENTE
  BACKTESTING_VIDA_UTIL
}

model Usuario {
  id                    String             @id @default(uuid()) @db.Uuid
  usuario               String             @unique @db.VarChar(80)
  nome                  String             @db.VarChar(120)
  senhaHash             String             @db.VarChar(255)
  papel                 PapelUsuario
  ativo                 Boolean            @default(true)
  ultimoAcesso          DateTime?          @db.Timestamptz(3)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)
  versao                Int                @default(1)
  authVersion           Int                @default(1)
  tokensRevogados       TokenRevogado[]
  movimentacoes         Movimentacao[]
  auditorias            EventoAuditoria[]   @relation("AuditoriaAtor")
  parametrosAtualizados ParametroGlobal[]   @relation("ParametroAtualizadoPor")
  triagensResponsavel  HistoricoTriagem[]    @relation("TriagemResponsavel")
  relatoriosSolicitados RelatorioAssincrono[] @relation("RelatorioSolicitante")

  @@index([ativo, papel])
  @@map("usuarios")
}

model TokenRevogado {
  jti       String   @id @db.VarChar(100)
  usuarioId String   @db.Uuid
  expiraEm  DateTime @db.Timestamptz(3)
  revogadoEm DateTime @default(now()) @db.Timestamptz(3)
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([usuarioId, expiraEm])
  @@index([expiraEm])
  @@map("tokens_revogados")
}

model Organizacao {
  id                 String     @id @default(uuid()) @db.Uuid
  razaoSocial        String     @db.VarChar(180)
  cnpj               String     @unique @db.VarChar(14)
  inscricaoEstadual  String?    @db.VarChar(30)
  enderecoCompleto   String?    @db.VarChar(300)
  telefone           String?    @db.VarChar(30)
  email              String?    @db.VarChar(254)
  dataCadastro       DateTime   @default(now()) @db.Timestamptz(3)
  ativo              Boolean    @default(true)
  createdAt          DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @db.Timestamptz(3)
  versao             Int        @default(1)
  contratos          Contrato[]
  lotes              Lote[]
  parceiros          ParceiroOrganizacao[]
  auditorias         EventoAuditoria[]
  analises           ExecucaoAnalise[]
  relatorios         RelatorioAssincrono[]

  @@index([razaoSocial])
  @@index([ativo])
  @@map("organizacoes")
}

model Contrato {
  id                  String       @id @default(uuid()) @db.Uuid
  organizacaoId       String       @db.Uuid
  dataAssinatura      DateTime     @default(now()) @db.Timestamptz(3)
  dataVencimento      DateTime     @db.Timestamptz(3)
  clausulas           String[]     @default([])
  valorMensal         Decimal      @db.Decimal(12, 2)
  renovacaoAutomatica Boolean      @default(false)
  ativo               Boolean      @default(true)
  dataCancelamento    DateTime?    @db.Timestamptz(3)
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)
  versao              Int          @default(1)
  organizacao         Organizacao  @relation(fields: [organizacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([organizacaoId, dataVencimento])
  @@index([ativo, dataVencimento])
  @@map("contratos")
}

model Lote {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizacaoId      String                 @db.Uuid
  dataEntrada        DateTime               @default(now()) @db.Timestamptz(3)
  notaFiscal         String                 @db.VarChar(100)
  transportadora     String                 @db.VarChar(120)
  statusProcessamento StatusProcessamentoLote @default(RECEBIDO)
  observacoes        String                 @default("") @db.VarChar(2000)
  demonstracao       Boolean                @default(false)
  ativo              Boolean                @default(true)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)
  versao             Int                    @default(1)
  organizacao        Organizacao            @relation(fields: [organizacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  equipamentos       Equipamento[]
  referenciasExternas ReferenciaExternaParceiro[]
  idempotencias       RequisicaoIdempotencia[]
  historicoTriagem    HistoricoTriagem[]
  publicId           String                 @unique @default(dbgenerated("('gcl_'::text || replace(gen_random_uuid()::text, '-'::text, ''::text))")) @db.VarChar(40)

  @@index([organizacaoId, statusProcessamento])
  @@index([dataEntrada])
  @@index([ativo])
  @@index([demonstracao, dataEntrada])
  @@map("lotes")
}

model Equipamento {
  id                 String             @id @default(uuid()) @db.Uuid
  codigoBarrasInterno String             @unique @db.VarChar(64)
  tipo               TipoEquipamento
  marca              String             @db.VarChar(100)
  modelo             String             @db.VarChar(120)
  anoFabricacao      Int
  estadoFisico       EstadoFisico
  pesoQuilogramas    Decimal            @db.Decimal(10, 3)
  loteId             String?            @db.Uuid
  posicaoNoLote       Int?
  statusRastreamento StatusRastreamento  @default(AGUARDANDO_TRIAGEM)
  ativo              Boolean            @default(true)
  valorAquisicao     Decimal            @default(0) @db.Decimal(12, 2)
  demonstracao       Boolean            @default(false)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
  versao             Int                @default(1)
  lote               Lote?              @relation(fields: [loteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  movimentacoes      Movimentacao[]
  historicoTriagem   HistoricoTriagem[]
  falhas             FalhaEquipamento[]
  manutencoes        ManutencaoEquipamento[]
  depreciacoes       HistoricoDepreciacao[]
  avaliacoesRecuperacao AvaliacaoRecuperacao[]

  // SQL migration owns the partial unique index: Prisma @@unique requires all
  // compound fields to be mandatory, but this approved relationship is optional.
  @@index([loteId, statusRastreamento])
  @@index([tipo, estadoFisico])
  @@index([ativo])
  @@index([demonstracao, ativo])
  @@map("equipamentos")
}

model Movimentacao {
  id                       String      @id @default(uuid()) @db.Uuid
  equipamentoId            String      @db.Uuid
  dataHora                 DateTime    @default(now()) @db.Timestamptz(3)
  origem                   String      @db.VarChar(180)
  destino                  String      @db.VarChar(180)
  responsavelId            String      @db.Uuid
  responsavelNomeSnapshot  String      @db.VarChar(120)
  observacao               String      @default("") @db.VarChar(2000)
  equipamento              Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responsavel              Usuario     @relation(fields: [responsavelId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([equipamentoId, dataHora])
  @@index([responsavelId, dataHora])
  @@map("movimentacoes")
}

model EventoAuditoria {
  id                 String    @id @default(uuid()) @db.Uuid
  atorUsuarioId      String?   @db.Uuid
  atorNomeSnapshot   String?   @db.VarChar(120)
  acao               String    @db.VarChar(80)
  entidade           String    @db.VarChar(80)
  entidadeId         String    @db.VarChar(100)
  instante           DateTime  @default(now()) @db.Timestamptz(3)
  resultado          String    @db.VarChar(30)
  requestId          String?   @db.VarChar(100)
  detalhes            Json?
  atorTipo            String    @default("USUARIO") @db.VarChar(20)
  parceiroId          String?   @db.Uuid
  apiKeyId            String?   @db.Uuid
  organizacaoId       String?   @db.Uuid
  ator               Usuario?  @relation("AuditoriaAtor", fields: [atorUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parceiro            Parceiro? @relation(fields: [parceiroId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  apiKey              ApiKey?   @relation(fields: [apiKeyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organizacao         Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([instante])
  @@index([parceiroId, instante])
  @@index([apiKeyId, instante])
  @@index([organizacaoId, instante])
  @@index([entidade, entidadeId, instante])
  @@index([atorUsuarioId, instante])
  @@map("eventos_auditoria")
}

model ParametroGlobal {
  id                           String    @id @default("global") @db.VarChar(20)
  aliquotaImpostoPercentual    Decimal   @default(0) @db.Decimal(5, 2)
  taxaDepreciacaoAnualPercentual Decimal  @default(15) @db.Decimal(5, 2)
  atualizadoPorId              String?   @db.Uuid
  createdAt                    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                    DateTime  @updatedAt @db.Timestamptz(3)
  versao                       Int       @default(1)
  atualizadoPor                Usuario?  @relation("ParametroAtualizadoPor", fields: [atualizadoPorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@map("parametros_globais")
}


model Parceiro {
  id                          String                  @id @default(uuid()) @db.Uuid
  nome                        String                  @db.VarChar(160)
  descricao                   String?                 @db.VarChar(1000)
  ativo                       Boolean                 @default(true)
  escopos                     String[]                @default([])
  limiteRequisicoesPorMinuto  Int                     @default(60)
  maxEquipamentosPorSubmissao Int                     @default(100)
  maxPayloadBytes             Int                     @default(1048576)
  permiteLoteSemEquipamentos  Boolean                 @default(true)
  createdAt                   DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                @updatedAt @db.Timestamptz(3)
  organizacoes                ParceiroOrganizacao[]
  apiKeys                     ApiKey[]
  idempotencias               RequisicaoIdempotencia[]
  referenciasExternas         ReferenciaExternaParceiro[]
  auditorias                  EventoAuditoria[]
  relatorios                  RelatorioAssincrono[]

  @@index([ativo, nome])
  @@map("parceiros")
}

model ParceiroOrganizacao {
  id                   String       @id @default(uuid()) @db.Uuid
  parceiroId           String       @db.Uuid
  organizacaoId        String       @db.Uuid
  identificadorPublico String       @unique @db.VarChar(64)
  ativo                Boolean      @default(true)
  revogadoEm           DateTime?    @db.Timestamptz(3)
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)
  parceiro             Parceiro     @relation(fields: [parceiroId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organizacao          Organizacao  @relation(fields: [organizacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([parceiroId, organizacaoId])
  @@index([parceiroId, ativo])
  @@index([organizacaoId, ativo])
  @@map("parceiros_organizacoes")
}

model ApiKey {
  id                          String                  @id @default(uuid()) @db.Uuid
  parceiroId                  String                  @db.Uuid
  nome                        String                  @db.VarChar(120)
  prefixo                     String                  @unique @db.VarChar(40)
  segredoHash                 String                  @db.Char(64)
  escopos                     String[]                @default([])
  limiteRequisicoesPorMinuto  Int?
  maxEquipamentosPorSubmissao Int?
  maxPayloadBytes             Int?
  expiraEm                    DateTime?               @db.Timestamptz(3)
  revogadaEm                  DateTime?               @db.Timestamptz(3)
  ultimoUsoEm                 DateTime?               @db.Timestamptz(3)
  createdAt                   DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                @updatedAt @db.Timestamptz(3)
  parceiro                    Parceiro                @relation(fields: [parceiroId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  auditorias                  EventoAuditoria[]
  relatorios                  RelatorioAssincrono[]

  @@index([parceiroId, createdAt])
  @@index([parceiroId, revogadaEm, expiraEm])
  @@map("api_keys")
}

model RequisicaoIdempotencia {
  id          String    @id @default(uuid()) @db.Uuid
  parceiroId  String    @db.Uuid
  chave       String    @db.VarChar(200)
  requestHash String    @db.Char(64)
  loteId      String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  parceiro    Parceiro  @relation(fields: [parceiroId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lote        Lote      @relation(fields: [loteId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([parceiroId, chave])
  @@index([loteId])
  @@map("requisicoes_idempotencia")
}

model ReferenciaExternaParceiro {
  id          String    @id @default(uuid()) @db.Uuid
  parceiroId  String    @db.Uuid
  externalId  String    @db.VarChar(200)
  requestHash String    @db.Char(64)
  loteId      String    @db.Uuid
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  parceiro    Parceiro  @relation(fields: [parceiroId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lote        Lote      @relation(fields: [loteId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([parceiroId, externalId])
  @@unique([parceiroId, loteId])
  @@index([loteId])
  @@map("referencias_externas_parceiro")
}


model HistoricoTriagem {
  id             String      @id @default(uuid()) @db.Uuid
  sessaoId       String      @db.Uuid
  loteId         String      @db.Uuid
  equipamentoId  String?     @db.Uuid
  responsavelId  String      @db.Uuid
  etapa          String      @db.VarChar(30)
  ocorridoEm     DateTime    @default(now()) @db.Timestamptz(3)
  observacao     String?     @db.VarChar(2000)
  demonstracao   Boolean     @default(false)
  origemSessao   String      @default("AV3") @db.VarChar(24)
  mensuravel     Boolean     @default(true)
  lote           Lote        @relation(fields: [loteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  equipamento    Equipamento? @relation(fields: [equipamentoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  responsavel    Usuario     @relation("TriagemResponsavel", fields: [responsavelId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([loteId, ocorridoEm])
  @@index([sessaoId, etapa])
  @@index([origemSessao, mensuravel, ocorridoEm])
  @@index([responsavelId, ocorridoEm])
  @@map("historico_triagem")
}

model FalhaEquipamento {
  id             String      @id @default(uuid()) @db.Uuid
  equipamentoId  String      @db.Uuid
  ocorridoEm     DateTime    @default(now()) @db.Timestamptz(3)
  categoria      String      @db.VarChar(80)
  severidade     String      @db.VarChar(20)
  descricao      String      @db.VarChar(2000)
  resolvidaEm    DateTime?   @db.Timestamptz(3)
  demonstracao   Boolean     @default(false)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  equipamento    Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([equipamentoId, ocorridoEm])
  @@index([severidade, ocorridoEm])
  @@map("falhas_equipamentos")
}

model ManutencaoEquipamento {
  id             String      @id @default(uuid()) @db.Uuid
  equipamentoId  String      @db.Uuid
  realizadaEm    DateTime    @default(now()) @db.Timestamptz(3)
  tipo           String      @db.VarChar(40)
  descricao      String      @db.VarChar(2000)
  custo          Decimal?    @db.Decimal(12, 2)
  demonstracao   Boolean     @default(false)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  equipamento    Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([equipamentoId, realizadaEm])
  @@map("manutencoes_equipamentos")
}

model HistoricoDepreciacao {
  id                    String      @id @default(uuid()) @db.Uuid
  equipamentoId         String      @db.Uuid
  avaliadoEm            DateTime    @default(now()) @db.Timestamptz(3)
  valorEstimado         Decimal     @db.Decimal(12, 2)
  taxaAnualPercentual   Decimal?    @db.Decimal(7, 4)
  estadoFisico          EstadoFisico
  metodo                String      @db.VarChar(60)
  demonstracao          Boolean     @default(false)
  createdAt             DateTime    @default(now()) @db.Timestamptz(3)
  equipamento           Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([equipamentoId, avaliadoEm])
  @@map("historico_depreciacao")
}

model ReferenciaRecuperacao {
  id                       String          @id @default(uuid()) @db.Uuid
  tipo                     TipoEquipamento
  marca                    String?         @db.VarChar(100)
  modelo                   String?         @db.VarChar(120)
  estadoFisico             EstadoFisico
  valorMaterialPorKg       Decimal         @db.Decimal(12, 4)
  percentualRecuperavel    Decimal         @db.Decimal(7, 4)
  observacaoMetodologia     String          @db.VarChar(1000)
  demonstracao              Boolean         @default(false)
  ativa                    Boolean         @default(true)
  vigenciaInicio           DateTime        @default(now()) @db.Timestamptz(3)
  vigenciaFim              DateTime?       @db.Timestamptz(3)
  @@index([tipo, estadoFisico, ativa])
  @@index([tipo, estadoFisico, marca, modelo, ativa])
  @@index([demonstracao, ativa])
  avaliacoes AvaliacaoRecuperacao[]
  @@map("referencias_recuperacao")
}

model AvaliacaoRecuperacao {
  id               String      @id @default(uuid()) @db.Uuid
  equipamentoId    String      @db.Uuid
  avaliadoEm       DateTime    @default(now()) @db.Timestamptz(3)
  valorEstimado    Decimal     @db.Decimal(12, 2)
  valorRealizado   Decimal?    @db.Decimal(12, 2)
  metodo           String      @db.VarChar(80)
  quantidadeKg     Decimal     @db.Decimal(10, 3)
  demonstracao     Boolean     @default(false)
  realizadoEm     DateTime?   @db.Timestamptz(3)
  observacao       String?     @db.VarChar(1000)
  valorReferenciaPorKg Decimal? @db.Decimal(12, 4)
  percentualRecuperavel Decimal? @db.Decimal(7, 4)
  fonteReferencia String? @db.VarChar(60)
  observacaoReferencia String? @db.VarChar(1000)
  referenciaRecuperacaoId String? @db.Uuid
  equipamento      Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  referenciaRecuperacao ReferenciaRecuperacao? @relation(fields: [referenciaRecuperacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([equipamentoId, avaliadoEm])
  @@index([demonstracao, avaliadoEm])
  @@index([referenciaRecuperacaoId])
  @@map("avaliacoes_recuperacao")
}

model ExecucaoAnalise {
  id              String       @id @default(uuid()) @db.Uuid
  tipo            TipoAnalise
  organizacaoId   String?      @db.Uuid
  metodo          String       @db.VarChar(100)
  versaoModelo    String       @db.VarChar(40)
  filtros         Json
  resultado       Json
  observacoes     Int          @default(0)
  confiabilidade  Decimal?     @db.Decimal(7, 4)
  indisponivel    Boolean      @default(false)
  motivo          String?      @db.VarChar(500)
  demonstracao    Boolean      @default(false)
  origemExecucao  String       @default("MANUAL") @db.VarChar(20)
  schedulerId     String?      @db.VarChar(100)
  jobId           String?      @db.VarChar(160)
  chaveExecucao   String?      @unique @db.VarChar(260)
  executadoEm     DateTime     @default(now()) @db.Timestamptz(3)
  organizacao     Organizacao? @relation(fields: [organizacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([tipo, executadoEm])
  @@index([origemExecucao, executadoEm])
  @@index([organizacaoId, tipo, executadoEm])
  @@map("execucoes_analise")
}

model RelatorioAssincrono {
  id                   String          @id @default(uuid()) @db.Uuid
  tipo                 String          @db.VarChar(60)
  formato              String          @db.VarChar(10)
  status               StatusRelatorio @default(PENDING)
  solicitanteUsuarioId String?         @db.Uuid
  parceiroId           String?         @db.Uuid
  apiKeyId             String?         @db.Uuid
  organizacaoId        String          @db.Uuid
  filtros              Json
  jobId                String          @unique @db.VarChar(100)
  arquivoPath          String?         @db.VarChar(500)
  arquivoSha256        String?         @db.Char(64)
  tamanhoBytes         BigInt?
  progresso            Int             @default(0)
  mensagemErro         String?         @db.VarChar(1000)
  requestId            String?         @db.VarChar(100)
  criadoEm             DateTime        @default(now()) @db.Timestamptz(3)
  iniciadoEm           DateTime?       @db.Timestamptz(3)
  heartbeatEm           DateTime?       @db.Timestamptz(3)
  leaseToken            String?         @db.VarChar(100)
  concluidoEm          DateTime?       @db.Timestamptz(3)
  expiraEm             DateTime        @db.Timestamptz(3)
  solicitante          Usuario?        @relation("RelatorioSolicitante", fields: [solicitanteUsuarioId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parceiro             Parceiro?      @relation(fields: [parceiroId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  apiKey               ApiKey?        @relation(fields: [apiKeyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  organizacao          Organizacao    @relation(fields: [organizacaoId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([organizacaoId, criadoEm])
  @@index([parceiroId, criadoEm])
  @@index([status, expiraEm])
  @@map("relatorios_assincronos")
}

model OutboxEvento {
  id             String    @id @default(uuid()) @db.Uuid
  agregado       String    @db.VarChar(80)
  agregadoId     String    @db.VarChar(100)
  evento         String    @db.VarChar(100)
  payload        Json
  criadoEm       DateTime  @default(now()) @db.Timestamptz(3)
  publicadoEm    DateTime? @db.Timestamptz(3)
  tentativas     Int       @default(0)
  proximaTentativaEm DateTime? @db.Timestamptz(3)
  ultimoErro     String?   @db.VarChar(1000)
  @@index([publicadoEm, criadoEm])
  @@index([agregado, agregadoId])
  @@map("outbox_eventos")
}

model RateLimitBucket {
  chave        String   @db.VarChar(160)
  janelaInicio DateTime @db.Timestamptz(3)
  quantidade   Int      @default(0)
  expiraEm     DateTime @db.Timestamptz(3)
  @@id([chave, janelaInicio])
  @@index([expiraEm])
  @@map("rate_limit_buckets")
}
